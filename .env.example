# Copy to .env and fill in. Never commit .env.

# Kaggle API (for downloading kaggle_oral)
KAGGLE_USERNAME=
KAGGLE_KEY=

# LLM provider for genai/ (RAG + agent). Leave LLM_PROVIDER empty to run the explainer without an LLM
# (it then quotes the best-matching sentences). anthropic | openai (any OpenAI-compatible server)
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
# Only for a self-hosted OpenAI-compatible server, e.g. llama-swap: http://host:port/v1
LLM_BASE_URL=

# llama-swap server used by models/classifier/notebooks/Daniel/qwen_clean_and_label.ipynb
LLAMA_SWAP_API_KEY=

# Embeddings / vector store (RAG)
EMBEDDING_MODEL=
VECTOR_DB_PATH=genai/rag/index

# App
APP_ENV=development
BACKEND_PORT=8000
