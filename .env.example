# Copy to .env and fill in. Never commit .env.

# Kaggle API (for downloading kaggle_oral)
KAGGLE_USERNAME=
KAGGLE_KEY=

# LLM provider for genai/ (RAG + agent)
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# llama-swap server used by models/classifier/notebooks/Daniel/qwen_clean_and_label.ipynb
LLAMA_SWAP_API_KEY=

# Embeddings / vector store (RAG)
EMBEDDING_MODEL=
VECTOR_DB_PATH=genai/rag/index

# App
APP_ENV=development
BACKEND_PORT=8000
